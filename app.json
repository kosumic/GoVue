{
  "expo": {
    "name": "GoVue",
    "slug": "govue",
    "version": "0.1.0",
    "scheme": ["govue", "lingoplay"],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "io.github.kaminarios.lingoplay",
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "https", "host": "youtube.com" },
            { "scheme": "https", "host": "www.youtube.com" },
            { "scheme": "https", "host": "m.youtube.com" },
            { "scheme": "https", "host": "music.youtube.com" },
            { "scheme": "https", "host": "youtu.be" }
          ]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        }
      ],
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "io.github.kaminarios.lingoplay",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-sharing",
      "./plugins/withLocalMedia.cjs",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow GoVue to use the microphone for voice input in chat.",
          "speechRecognitionPermission": "Allow GoVue to turn your speech into chat messages."
        }
      ]
    ]
  }
}
