{
  "name": "govue",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-video"
        ]
      },
      "android": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "preview:mockups": "node scripts/generate-readme-phone-mockups.ts",
    "page:build": "node scripts/build-page.ts",
    "postinstall": "node scripts/patch-video.ts && node scripts/patch-translate.ts && npm run page:build",
    "start": "expo start --dev-client --scheme govue --host lan",
    "android": "expo run:android",
    "ios": "npm run core:ios && expo run:ios",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "core:build": "node scripts/build-core.ts host",
    "core:android": "node scripts/build-core.ts android",
    "core:ios": "node scripts/build-core.ts ios",
    "prebuild:ios": "npm run core:ios && expo prebuild --platform ios",
    "check:app-version": "node scripts/check-app-version.cjs",
    "test": "node --test tests/*.test.*",
    "test:ios-http": "node scripts/test-ios-http.ts",
    "fmt:core": "cargo fmt --all --check",
    "lint:core": "cargo clippy --locked --workspace --all-targets -- -D warnings",
    "test:core": "cargo test --locked -p govue-core",
    "check": "npm run check:app-version && npm run typecheck && npm test && npm run fmt:core && npm run lint:core && npm run test:core"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "1.16.3",
    "bgutils-js": "^4.0.3",
    "expo": "~57.0.30",
    "expo-brightness": "~57.0.2",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-screen-orientation": "~57.0.3",
    "expo-sharing": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-translate-text": "^0.3.0",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.16",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": true,
    "codeHighlightLanguages": [
      "rust",
      "typescript",
      "javascript",
      "tsx",
      "python",
      "bash",
      "json",
      "yaml",
      "markdown",
      "c",
      "cpp",
      "go"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
