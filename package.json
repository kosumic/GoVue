{
  "name": "govue",
  "version": "0.3.1",
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-video"
        ]
      },
      "android": {
        "buildFromSource": [
          "expo-camera",
          "expo-video"
        ]
      }
    }
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "preview:mockups": "node scripts/generate-readme-phone-mockups.ts",
    "page:build": "node scripts/build-page.ts",
    "postinstall": "node scripts/patch-security-dependencies.ts && node scripts/patch-video.ts && node scripts/patch-translate.ts && node scripts/patch-webview.ts && npm run page:build",
    "start": "expo start --dev-client --scheme govue --host lan",
    "android": "expo run:android",
    "ios": "npm run core:ios && expo run:ios",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "core:build": "node scripts/build-core.ts host",
    "core:android": "node scripts/build-core.ts android",
    "core:ios": "node scripts/build-core.ts ios",
    "prebuild:ios": "npm run core:ios && expo prebuild --platform ios",
    "check:app-version": "node scripts/check-app-version.cjs",
    "licenses:generate": "node scripts/license-notices.ts --write",
    "check:licenses": "node scripts/license-notices.ts",
    "test": "node --test tests/*.test.*",
    "test:ios-http": "node scripts/test-ios-http.ts",
    "fmt:core": "cargo fmt --all --check",
    "lint:core": "cargo clippy --locked --workspace --all-targets -- -D warnings",
    "test:core": "cargo test --locked -p govue-core",
    "check": "npm run check:app-version && npm run check:licenses && npm run lint && npm run typecheck && npm test && npm run fmt:core && npm run lint:core && npm run test:core"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "1.16.3",
    "bgutils-js": "^4.0.3",
    "expo": "~58.0.19",
    "expo-brightness": "~58.0.2",
    "expo-camera": "~58.0.12",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-screen-orientation": "~58.0.3",
    "expo-sharing": "~58.0.20",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.0",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-translate-text": "^0.3.0",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": true,
    "codeHighlightLanguages": [
      "rust",
      "typescript",
      "javascript",
      "tsx",
      "python",
      "bash",
      "json",
      "yaml",
      "markdown",
      "c",
      "cpp",
      "go"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
